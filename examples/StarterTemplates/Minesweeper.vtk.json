  "imports": "# A 9x9 board with ten mines and a safe first reveal.\nimport random\n\n\ndef mines_neighbors(index):\n    row, column = divmod(index, 9)\n    return [r * 9 + c for r in range(max(0, row - 1), min(9, row + 2)) for c in range(max(0, column - 1), min(9, column + 2)) if (r, c) != (row, column)]\n\n\ndef mines_place(first, rng=None):\n    # Exclude the first cell and its neighbors so the first reveal opens safely.\n    rng = rng or random.Random()\n    excluded = set(mines_neighbors(first)) | {first}\n    return set(rng.sample([i for i in range(81) if i not in excluded], 10))\n\n\ndef mines_count(app, index):\n    return sum(neighbor in app.mine_cells for neighbor in mines_neighbors(index))\n\n\ndef mines_render(app):\n    for index in range(81):\n        revealed = index in app.mine_revealed\n        text = \"\"\n        if app.mine_done and app.mine_cells is not None and index in app.mine_cells:\n            text = \"*\"\n        elif index in app.mine_flags:\n            text = \"F\"\n        elif revealed:\n            count = mines_count(app, index)\n            text = str(count) if count else \"\"\n        getattr(app, \"Cell\" + str(index)).configure(text=text, state=\"disabled\" if revealed or app.mine_done else \"normal\", bg=\"#ffffff\" if revealed else \"#dbe6f5\")\n    state = \"Won!\" if app.mine_done and len(app.mine_revealed) == 71 else \"Game over\" if app.mine_done else \"Find all safe cells\"\n    app.StatusLabel.configure(text=f\"{state} | Flags: {len(app.mine_flags)} / 10 | Safe: {len(app.mine_revealed)} / 71\")\n\n\ndef mines_reset(app):\n    # Mine positions are chosen only on the first unflagged reveal.\n    app.mine_cells = None\n    app.mine_revealed = set()\n    app.mine_flags = set()\n    app.mine_done = False\n    mines_render(app)\n\n\ndef mines_flag(app, index):\n    if app.mine_done or index in app.mine_revealed:\n        return \"break\"\n    if index in app.mine_flags:\n        app.mine_flags.remove(index)\n    elif len(app.mine_flags) < 10:\n        app.mine_flags.add(index)\n    mines_render(app)\n    return \"break\"\n\n\ndef mines_reveal(app, index):\n    if app.mine_done or index in app.mine_flags or index in app.mine_revealed:\n        return\n    if app.mine_cells is None:\n        app.mine_cells = mines_place(index)\n    if index in app.mine_cells:\n        app.mine_done = True\n        mines_render(app)\n        return\n    # Iterative flood fill avoids recursive callbacks for empty areas.\n    pending = [index]\n    while pending:\n        current = pending.pop()\n        if current in app.mine_revealed or current in app.mine_flags or current in app.mine_cells:\n            continue\n        app.mine_revealed.add(current)\n        if mines_count(app, current) == 0:\n            pending.extend(mines_neighbors(current))\n    if len(app.mine_revealed) == 71:\n        app.mine_done = True\n    mines_render(app)\n",
  "startup": "# Right click, middle click or Control-click toggles a flag.\nmines_reset(self)\nfor index in range(81):\n    cell = getattr(self, \"Cell\" + str(index))\n    for sequence in (\"<Button-3>\", \"<Button-2>\", \"<Control-Button-1>\"):\n        cell.bind(sequence, lambda event, index=index: mines_flag(self, index))\nself.Form1.deiconify()"
}
