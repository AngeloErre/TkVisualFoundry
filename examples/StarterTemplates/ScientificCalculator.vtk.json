  "imports": "# Parse arithmetic with an allowlisted AST; never call eval or exec.\nimport ast\nimport math\nimport operator\n\n\ndef calc_factorial(value):\n    if int(value) != value or not 0 <= value <= 50:\n        raise ValueError(\"factorial accepts whole numbers from 0 to 50\")\n    return math.factorial(int(value))\n\n\ndef calc_expression(expression):\n    # Bound input size, tree size, exponent size and every intermediate result.\n    if not isinstance(expression, str) or not 1 <= len(expression.strip()) <= 256:\n        raise ValueError(\"Use an expression of 1-256 characters\")\n    tree = ast.parse(expression.strip(), mode=\"eval\")\n    if sum(1 for node in ast.walk(tree)) > 100:\n        raise ValueError(\"Expression is too complex\")\n    binary = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul, ast.Div: operator.truediv, ast.FloorDiv: operator.floordiv, ast.Mod: operator.mod, ast.Pow: operator.pow}\n    functions = {\"sin\": math.sin, \"cos\": math.cos, \"tan\": math.tan, \"asin\": math.asin, \"acos\": math.acos, \"atan\": math.atan, \"sqrt\": math.sqrt, \"log\": math.log, \"log10\": math.log10, \"exp\": math.exp, \"abs\": abs, \"factorial\": calc_factorial}\n    constants = {\"pi\": math.pi, \"e\": math.e, \"tau\": math.tau}\n    def visit(node):\n        if isinstance(node, ast.Constant) and type(node.value) in (int, float):\n            value = node.value\n            if abs(value) > 1e12:\n                raise ValueError(\"Numeric literals must be at most 1e12\")\n        elif isinstance(node, ast.Name) and node.id in constants:\n            value = constants[node.id]\n        elif isinstance(node, ast.UnaryOp) and type(node.op) in (ast.UAdd, ast.USub):\n            value = visit(node.operand) * (-1 if isinstance(node.op, ast.USub) else 1)\n        elif isinstance(node, ast.BinOp) and type(node.op) in binary:\n            left, right = visit(node.left), visit(node.right)\n            if isinstance(node.op, ast.Pow) and abs(right) > 12:\n                raise ValueError(\"Exponents must be between -12 and 12\")\n            value = binary[type(node.op)](left, right)\n        elif isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id in functions and not node.keywords and 1 <= len(node.args) <= 2:\n            value = functions[node.func.id](*[visit(arg) for arg in node.args])\n        else:\n            raise ValueError(\"Only arithmetic, listed math functions and pi/e/tau are allowed\")\n        if type(value) not in (int, float) or not math.isfinite(value) or abs(value) > 1e100:\n            raise ValueError(\"Result is non-real, non-finite or outside the supported range\")\n        return value\n    return visit(tree.body)\n\n\ndef calc_insert(app, token):\n    app.ExpressionEntry.insert(\"insert\", token)\n    app.ExpressionEntry.focus_set()\n\n\ndef calc_calculate(app):\n    expression = app.ExpressionEntry.get()\n    try:\n        value = calc_expression(expression)\n    except (ValueError, TypeError, SyntaxError, ZeroDivisionError, OverflowError) as error:\n        app.ResultLabel.configure(text=\"Error: \" + str(error))\n        return\n    result = format(value, \".12g\")\n    app.ResultLabel.configure(text=result)\n    app.calc_history.insert(0, (expression, result))\n    del app.calc_history[100:]\n    app.HistoryList.delete(0, \"end\")\n    for text, answer in app.calc_history:\n        app.HistoryList.insert(\"end\", text + \" = \" + answer)\n\n\ndef calc_reuse(app):\n    selected = app.HistoryList.curselection()\n    if selected:\n        app.ExpressionEntry.delete(0, \"end\")\n        app.ExpressionEntry.insert(0, app.calc_history[selected[0]][0])\n",
  "startup": "# Trigonometric inputs are radians; ** is exponentiation.\nself.calc_history = []\nself.ExpressionEntry.insert(0, \"sqrt(81) + sin(pi / 2)\")\nself.ExpressionEntry.bind(\"<Return>\", lambda event: calc_calculate(self))\nself.HistoryList.bind(\"<<ListboxSelect>>\", lambda event: calc_reuse(self))\nself.Form1.deiconify()"
}
