  "imports": "# Assign local sounds explicitly. The built-in player initializes audio only on Play.\nfrom pathlib import Path\n\ndef sound_assign(app):\n    path = filedialog.askopenfilename(parent=app.Form1,filetypes=[('Audio','*.wav *.mp3 *.ogg')])\n    if not path:\n        return\n    try:\n        slot = int(app.Slot.get())\n        if not 1 <= slot <= 8 or not Path(path).is_file():\n            raise ValueError('Choose a valid slot and existing audio file.')\n        app.sounds[slot] = path\n        getattr(app,'Pad'+str(slot)).configure(text=f'{slot}: {Path(path).name}')\n    except (ValueError,OSError) as exc:\n        messagebox.showerror('Soundboard',str(exc),parent=app.Form1)\n\ndef sound_play(app, slot):\n    path = app.sounds.get(slot)\n    if not path:\n        messagebox.showinfo('Soundboard','Assign an audio file to this slot first.',parent=app.Form1)\n        return\n    app.Player.source = path\n    app.Player.play()\n",
  "startup": "# Audio assignments remain in memory; no file is opened or played at startup.\nself.sounds = {}\nself.Slot.set('1')\nself.Form1.deiconify()\n",
